#!/usr/bin/env bun
/**
 * consult — resume-fork a recorded session and ask it a question, restoring the
 * transcript from the durable archive if the local cache has lost it.
 *
 *   bun .claude/bin/consult <role@machine/session-id[#msg]> "<question>" [--model fable|opus] [--usage-json] [--dry]
 *
 * The ladder: transcript present locally → resume; absent → restore from
 * work/sessions/<machine>/<uuid>.jsonl.gz → resume; archive miss → degrade
 * (documents + fresh dispatch). Cross-machine handles stop with a clear message
 * (the cross-LAN intercom is deferred; see work/proposals/). A consult is
 * advisory — interpretation, never new decisions (work/README.md § grammar).
 *
 * The fork runs under a read-only capability boundary (see cmd, below): it can
 * read and answer, never act. And it is repo-bound — a handle resolves only
 * where the transcript's recorded cwd matches the consulting repo.
 *
 * The child runs with stream-json output, and its event wire is parsed here — so
 * a consult reports what it cost. The caller-facing contract is unchanged:
 *   stdout — the answer text, alone. No JSON envelope, no usage line, ever.
 *   stderr — diagnostics, then usage as the last line: the raw token-counter
 *            field names, the cache-creation TTL split, and a per-consult cost
 *            delta. With --usage-json that last line is one JSON object instead.
 * Fallback, never default: an answer larger than ANSWER_MAX_BYTES (256 KiB) is
 * written to a file in the OS temp directory and its path returned on stdout in
 * place of the text, with a loud stderr note. Real answers are far below it.
 *
 * A run fails when the wire carries no terminal result event, or carries one
 * flagged as an error — never merely because stdout was empty.
 *
 * exit codes:
 *   0  ran (or --dry)
 *   1  usage / unparseable handle
 *   2  cross-machine handle (deferred)
 *   3  the consult cannot be relied on — the transcript is unusable (absent from
 *      cache and archive, or it failed to resume), the fork produced no usable
 *      answer, the child could not be run at all, or the wire reported success
 *      while the child itself exited non-zero (there an answer HAS already been
 *      written to stdout, and the disagreement is reported). All take the
 *      degrade path.
 *   4  repo mismatch — transcript belongs to another repo (refuse; degrade)
 *   5  read-only boundary violation — a tool outside the allowlist executed
 *      SUCCESSFULLY during the fork. The answer HAS already been written to
 *      stdout (a parser false positive must not destroy a legitimate answer), and
 *      a loud warning precedes it on stderr. Distinct from 1 by design, so "you
 *      called me wrong" and "the read-only boundary was breached" are never the
 *      same byte. Precedence: the warning is emitted on EVERY exit path, degrade
 *      paths included; 5 is taken only when an answer was returned, so a
 *      violation on a degrade path leaves degrade's own code standing with the
 *      warning already on stderr.
 */
import { gunzipSync } from "node:zlib";
import { hostname, tmpdir } from "node:os";
import { readFileSync, writeFileSync, existsSync, mkdirSync } from "node:fs";
import { join, resolve } from "node:path";
import { spawnSync } from "node:child_process";

const machineLocal = hostname().split(".")[0];
const repoRoot = (() => {
  const r = spawnSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" });
  return r.status === 0 ? r.stdout.trim() : process.cwd();
})();
const slug = resolve(repoRoot).replace(/[^a-zA-Z0-9]/g, "-");
const projectDir = join(process.env.HOME!, ".claude", "projects", slug);

// ── the single exit ─────────────────────────────────────────────────────────
// Every exit in this file routes through finish(). The boundary verdict and the
// usage line are therefore emitted as a property of the code's STRUCTURE, not of
// each call site remembering to — the shape a per-call-site ordering fix keeps
// re-breaking at the next exit path someone adds.
//
// THE DEAD-ZONE INVARIANT, which a later reader must honour: finish() is a
// hoisted `function`, never a `const` arrow, because most exits fire above the
// helper stack (parseWire, renderUsage, the boundary predicate) and an arrow
// binding would be a temporal-dead-zone error at those call sites. For the same
// reason the helpers are reached only behind `if (wire…)`: `wire` stays null
// until parseWire has run, which is strictly after every helper is initialized.
// So finish() emits nothing at all on the early paths — and must not be changed
// to emit anything wire-derived outside those guards.
let wire: ReturnType<typeof parseWire> | null = null;
// Whether the answer already reached stdout. Drives the exit-5 precedence: a
// violation only overrides the exit code when there is an answer to have
// returned; on a degrade path degrade's own code stands, warning already sent.
let answerEmitted = false;

function finish(code: number): never {
  if (wire) {
    // Boundary verdict FIRST, usage render LAST. --usage-json's contract is that
    // stderr's final line parses as one JSON object, so anything emitted after
    // the render silently breaks every --usage-json caller.
    const unverified = boundaryUnverified(wire);
    if (unverified.length > 0)
      console.error(
        `BOUNDARY UNVERIFIED: ${unverified.length} tool result(s) could not be resolved back to a ` +
          `tool name (the originating tool_use was lost, typically to an unparseable wire line) — ` +
          `whether the read-only boundary held for them cannot be determined from this wire.`
      );
    const violations = boundaryViolations(wire);
    if (violations.length > 0) {
      const names = [...new Set(violations.map((v) => v.name))].sort().join(", ");
      console.error(
        `BOUNDARY VIOLATION: ${violations.length} tool call(s) outside the read-only allowlist ` +
          `(${[...ALLOWED_TOOLS].join(", ")}) executed SUCCESSFULLY during this consult: ${names}.\n` +
          `The fork was supposed to be able to read and answer, never act. Treat the answer as ` +
          `advisory and audit what that tool did.`
      );
      if (answerEmitted) code = 5;
    }
    // Guarded on `result`, not on `wire`, and deliberately a narrower condition
    // than the two above: usage is only meaningful once a terminal result exists,
    // whereas the boundary verdict must still fire on a stream that carried a
    // violation and then died mid-wire.
    if (wire.result) renderUsage(wire);
  }
  process.exit(code);
}

const args = process.argv.slice(2);
const dry = args.includes("--dry");
const usageJson = args.includes("--usage-json");
const modelIdx = args.indexOf("--model");
const model = modelIdx >= 0 ? args[modelIdx + 1] : "fable";
const positional = args.filter(
  (a, i) =>
    a !== "--dry" && a !== "--usage-json" && a !== "--model" && (modelIdx === -1 || i !== modelIdx + 1)
);
const [handle, question] = positional;

if (!handle || (!question && !dry)) {
  console.error(
    'usage: consult <role@machine/uuid[#msg]> "<question>" [--model fable] [--usage-json] [--dry]\n' +
      "  the fork is read-only (reads + answers, never acts) and repo-bound to this repo\n" +
      "  stdout is the answer alone; usage lands on stderr (--usage-json makes it one JSON object)"
  );
  finish(1);
}

const m = handle.match(
  /^(?:(?<role>[\w-]+)@)?(?:(?<machine>[\w-]+)\/)?(?<uuid>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:#(?<msg>\S+))?$/
);
if (!m?.groups) {
  console.error(`unparseable handle: ${handle} (expected role@machine/uuid[#msg])`);
  finish(1);
}
const { machine = machineLocal, uuid, msg } = m.groups as Record<string, string>;

if (machine !== machineLocal) {
  console.error(
    `handle is owned by '${machine}' (this is '${machineLocal}'). Cross-machine consults are deferred —\n` +
      `either restore that machine's archive here (work/sessions/${machine}/${uuid}.jsonl.gz) or consult on the owning machine.`
  );
  finish(2);
}

// The transcript's recorded cwd is the first line carrying a `cwd` field — NOT
// the first parseable line: transcripts lead with cwd-less mode/summary entries.
const transcriptCwd = (buf: Buffer): string | null => {
  for (const line of buf.toString("utf8").split("\n")) {
    if (!line) continue;
    try {
      const o = JSON.parse(line);
      if (typeof o.cwd === "string") return o.cwd;
    } catch {
      /* skip unparseable line */
    }
  }
  return null;
};

// Repo-binding guard: a handle resolves only where the transcript originated.
// Refuse a foreign transcript before it can act in this tree — and, for the
// archive path, before it materializes (so it never pollutes the local cache).
const bindOrRefuse = (cwd: string | null) => {
  if (cwd === null) {
    console.error(`warning: no cwd field in transcript ${uuid} — cannot verify repo binding; proceeding.`);
    return;
  }
  const origin = resolve(cwd);
  const here = resolve(repoRoot);
  if (origin !== here && !origin.startsWith(here + "/")) {
    console.error(
      `refuse: ${uuid} belongs to ${origin}, but this repo is ${here}.\n` +
        `A consult forks in place, so it may only resume a transcript from its owning repo.\n` +
        `Degrade path: consult from the owning repo, or answer from documents + a fresh dispatch.`
    );
    finish(4);
  }
};

const localPath = join(projectDir, `${uuid}.jsonl`);
if (existsSync(localPath)) {
  bindOrRefuse(transcriptCwd(readFileSync(localPath)));
} else {
  const archived = join(repoRoot, "work", "sessions", machine, `${uuid}.jsonl.gz`);
  if (existsSync(archived)) {
    const buf = gunzipSync(readFileSync(archived));
    bindOrRefuse(transcriptCwd(buf)); // parse before materializing
    mkdirSync(projectDir, { recursive: true });
    writeFileSync(localPath, buf);
    console.error(`restored: ${archived} -> ${localPath}`);
  } else {
    console.error(
      `no transcript for ${uuid} — not in the local cache nor in work/sessions/${machine}/.\n` +
        `Degrade path: answer from the documents + a fresh dispatch (planner-callback policy).`
    );
    finish(3);
  }
}

const prompt =
  (msg ? `(Citing your message ${msg}.) ` : "") +
  `Consultation via callback ${handle}. ${question ?? ""}` +
  ` Answer from your session's intent; flag explicitly if this needs a human decision.`;

// Read-only fork boundary — five independent layers, each covering a hole the
// others leave. `deny` is load-bearing, not belt: this repo's settings.json
// allows Bash(claude:*), and only a deny rule defeats a project allow, so a
// mode/allowlist-only fork could still spawn an unconstrained child claude.
// disableAllHooks because hooks run OUTSIDE the permission layers — else this
// repo's Stop→commit-guard and SessionEnd→session-archive fire inside a
// "read-only" fork. --permission-mode goes last: --allowedTools/--disallowedTools/
// --mcp-config are variadic and would otherwise swallow the trailing prompt.
//
// DENY is a strict superset of "anything that can mutate, message, schedule,
// escape, or publish". For the built-in harness/deferred tool class
// (EnterWorktree, TaskCreate, …) the boundary is NAME-DENY-ONLY: the allowlist
// ("Read,Grep,Glob") does NOT default-deny that class, so each such tool must be
// named here explicitly. Audited against `claude 2.1.220` (26-07-29; the 26-07-23
// crux probe still stands: deny of EnterWorktree makes it ABSENT from the fork's
// ToolSearch registry — enforcement is by name-filtering, strictly stronger than
// a runtime prompt).
// ⚠ ON A HARNESS UPGRADE: re-enumerate the deferred/built-in tool registry and
// reconcile DENY — a new mutating/escaping tool that isn't named here is NOT
// caught by the allowlist and silently re-opens the boundary.
// `Cd` was probed at the 2.1.220 audit and deliberately NOT added: invoked under
// this exact construction it returns the bare `No such tool available: Cd`,
// WITHOUT the "exists but is not enabled in this context" clause that every
// denied-by-name tool returns — and a deferred-registry lookup for it finds no
// match. It is absent from the build's registry, not merely denied, so naming it
// here would be speculation rather than a name deny-by-name governs.
// The deferred names aren't in the static tool registry at settings-parse time,
// so the harness may emit an intermittent "matches no known tool" warning to
// stderr — cosmetic; the deny still filters them from the deferred registry.
const DENY = [
  // classic mutation / shell / web
  "Edit", "Write", "NotebookEdit", "Bash", "WebFetch", "WebSearch",
  // subagent launchers + orchestration (route-around via a delegated child that
  // could carry its own tool grants). Skill is kept: it only injects read-only
  // instructions, and any tool a skill invokes is still gated by this deny.
  "Task", "Agent", "Workflow",
  // worktree / branch escape — real git mutation
  "EnterWorktree", "ExitWorktree",
  // background-task fleet
  "TaskCreate", "TaskStop", "TaskUpdate", "TaskGet", "TaskList", "TaskOutput",
  // messaging / scheduling / outward signalling (whole Cron family, incl. the read)
  "SendMessage", "SendUserMessage", "ListAgents", "RemoteTrigger",
  "PushNotification", "ScheduleWakeup",
  "CronCreate", "CronDelete", "CronList", "DesignSync", "Monitor",
  // plan-mode transitions
  "EnterPlanMode", "ExitPlanMode",
  // publishing (outward-facing web)
  "Artifact",
  // read-only MCP resource tools — moot under --strict-mcp-config, denied anyway
  "ReadMcpResourceTool", "ListMcpResourcesTool", "ReadMcpResourceDirTool",
];
const settings = JSON.stringify({
  permissions: { defaultMode: "dontAsk", deny: DENY },
  disableAllHooks: true,
});
const cmd = [
  "claude",
  "-p",
  "--resume",
  uuid,
  "--fork-session",
  // --output-format stream-json turns the child's stdout into the event wire the
  // parser below reads. --verbose is NOT required by the pinned CLI — re-probed:
  // the same run without it emits an identical terminal result event — but it is
  // retained deliberately, because older versions did require it alongside -p.
  // Both flags are non-variadic, so this position is safe; --permission-mode
  // still goes last, ahead of the prompt.
  "--output-format",
  "stream-json",
  "--verbose",
  "--model",
  model,
  "--settings",
  settings,
  "--strict-mcp-config",
  "--mcp-config",
  '{"mcpServers":{}}',
  "--allowedTools",
  "Read,Grep,Glob",
  "--disallowedTools",
  DENY.join(","),
  "--permission-mode",
  "dontAsk",
  prompt,
];

if (dry) {
  console.log(`ready: transcript present at ${localPath}`);
  console.log(`would run: ${cmd.map((c) => (c.includes(" ") ? JSON.stringify(c) : c)).join(" ")}`);
  finish(0);
}
// ── the event wire ──────────────────────────────────────────────────────────
// Hand-ported, not imported, from the spike harness that first mapped this wire:
// that harness lives in the process tree, which archives away, while this script
// has to run in a bootstrapped copy that never had it. Only the parsing and the
// trap discipline crossed over — the harness's async spawn and held-open stdin
// solve a deadlock class a single-shot consult does not have.
//
// Trap 2 — the `system`/`init` event re-fires once per turn, not once per
// process, so nothing here keys on "the init event" or assumes it is unique.
// Nor is `type` ever switched on exhaustively: the live stream carries types the
// wire map never enumerated (a rate-limit event, for one). Unknown types are
// retained in `events` and ignored.
type WireEvent = Record<string, any>;

const num = (v: unknown): number => (typeof v === "number" && Number.isFinite(v) ? v : 0);

const parseWire = (raw: string) => {
  const events: WireEvent[] = [];
  let unparsedLines = 0;
  for (const line of raw.split("\n")) {
    const s = line.trim();
    if (!s) continue;
    try {
      events.push(JSON.parse(s));
    } catch {
      unparsedLines++; // count, never throw: one bad line must not lose the run
    }
  }

  const resultEvents = events.filter((e) => e?.type === "result");
  const result = resultEvents.at(-1) ?? null;

  // Trap 1 — `total_cost_usd` is cumulative per process, so the per-consult cost
  // is a delta between the last two terminal results. A single-turn consult has
  // exactly one, making `prev` 0 and the delta the whole value — written as a
  // delta anyway so a future multi-turn caller inherits the right number rather
  // than silently the wrong one.
  const prev = resultEvents.length > 1 ? num(resultEvents.at(-2)!.total_cost_usd) : 0;
  const costUsd = num(result?.total_cost_usd) - prev;

  // Trap 3 — `assistant` events split one model call across content blocks, so
  // summing `assistant.message.usage` double-counts. Usage is read from the
  // terminal result instead (below); this walk is for TEXT ONLY, and it joins
  // the blocks rather than summing anything. It is the fallback for an answer
  // the terminal result did not carry.
  const assistantText = events
    .filter((e) => e?.type === "assistant" && Array.isArray(e?.message?.content))
    .flatMap((e) => e.message.content as any[])
    .filter((b) => b?.type === "text" && typeof b.text === "string")
    .map((b) => b.text as string)
    .join("");

  const answer =
    typeof result?.result === "string" && result.result.trim() !== "" ? result.result : assistantText;

  // The tool_use_id → tool-name correlation. Exposed for the boundary guard that
  // consumes it, so there is never a second parser. Built by walking CONTENT
  // BLOCKS on any event carrying an array `message.content` — deliberately not by
  // keying on a carrier event type, because the type carrying `tool_result`
  // blocks was never enumerated by the wire reconnaissance and guessing one would
  // be exactly the untested assumption this milestone was told to avoid.
  const toolNames = new Map<string, string>();
  const toolResults: { tool_use_id: string; name: string; is_error: boolean }[] = [];
  for (const e of events) {
    const content = e?.message?.content;
    if (!Array.isArray(content)) continue;
    for (const b of content) {
      if (b?.type === "tool_use" && typeof b.id === "string") toolNames.set(b.id, String(b.name ?? ""));
      else if (b?.type === "tool_result" && typeof b.tool_use_id === "string")
        toolResults.push({
          tool_use_id: b.tool_use_id,
          name: toolNames.get(b.tool_use_id) ?? "",
          is_error: b.is_error === true,
        });
    }
  }

  // Trap 4 — `usage.iterations[]` is not a per-call breakdown, and is therefore
  // deliberately not read; only the flat token counters and the nested cache-
  // creation TTL split are picked, under their raw field names. The terminal
  // result's refusal-tally field is deliberately not read either: it was measured
  // reporting empty across a session that genuinely refused two tools, so it is
  // evidence of nothing.
  const u = (result?.usage ?? {}) as Record<string, any>;
  const cc = (u.cache_creation ?? {}) as Record<string, any>;
  const usage = {
    input_tokens: num(u.input_tokens),
    output_tokens: num(u.output_tokens),
    cache_read_input_tokens: num(u.cache_read_input_tokens),
    cache_creation_input_tokens: num(u.cache_creation_input_tokens),
    cache_creation: {
      ephemeral_5m_input_tokens: num(cc.ephemeral_5m_input_tokens),
      ephemeral_1h_input_tokens: num(cc.ephemeral_1h_input_tokens),
    },
  };

  return { events, result, answer, usage, costUsd, toolNames, toolResults, unparsedLines };
};

// Fallback, never default: beyond this an answer is written to a file and the
// path returned in its place. Two orders of magnitude below maxBuffer, so the two
// failure modes stay independent, and far above any real answer.
const ANSWER_MAX_BYTES = 256 * 1024;

// Usage, last on stderr by construction — on the success path and on every
// degrade path that got far enough to have a terminal result. --usage-json emits
// one JSON object INSTEAD of the human line, so stderr's last line parses
// unfiltered. Raw field names verbatim; cost carries both the per-consult delta
// and the process cumulative under its own name, so no raw name is redefined.
const renderUsage = (w: ReturnType<typeof parseWire>) => {
  const u = w.usage;
  if (usageJson) {
    console.error(
      JSON.stringify({ ...u, cost_usd: w.costUsd, total_cost_usd: num(w.result?.total_cost_usd) })
    );
  } else {
    console.error(
      `usage: input_tokens=${u.input_tokens} output_tokens=${u.output_tokens} ` +
        `cache_read_input_tokens=${u.cache_read_input_tokens} ` +
        `cache_creation_input_tokens=${u.cache_creation_input_tokens} ` +
        `(ephemeral_5m_input_tokens=${u.cache_creation.ephemeral_5m_input_tokens} ` +
        `ephemeral_1h_input_tokens=${u.cache_creation.ephemeral_1h_input_tokens}) ` +
        `cost_usd=${w.costUsd.toFixed(6)}`
    );
  }
};

// ── the read-only boundary guard ────────────────────────────────────────────
// The names the guard treats as sanctioned. This is NOT the --allowedTools
// argument above: it MIRRORS THE HARNESS'S GRANTED REGISTRY as observed at
// `claude 2.1.220` — the six names the fork's own `system`/`init` event declares.
// --allowedTools does not bound the grant. Asking for three names leaves the
// other three present anyway, because they are read-only harness tools nothing in
// DENY strips; the request narrows nothing on its own. So the guard's question is
// "did anything beyond the harness's granted set execute successfully?", and a
// literal three-name set would fire on every ordinary consult.
// This is a deliberate operator ruling, not drift: do NOT "correct" this back to
// the three requested names.
// ⚠ THE COST OF MIRRORING THE GRANT: this set goes stale on a harness upgrade,
// and a build that grants a MUTATING tool would widen this boundary SILENTLY —
// the guard would read the new name as sanctioned. Re-enumerate it on EVERY
// harness upgrade, against the `init` event of a real fork, never against
// documentation. It is kept a literal set, not derived at runtime, precisely so
// that re-enumeration is a visible diff.
const ALLOWED_TOOLS = new Set(["Read", "Grep", "Glob", "ReportFindings", "Skill", "ToolSearch"]);

// What the guard exists to stop trusting: the terminal result event's
// refusal-tally field. M1 measured it reporting empty across every result event
// of a session that had genuinely refused two tools — an auditor reading it sees
// a clean sheet on a session that was actively blocking. So the evidence is taken
// per-`tool_result` instead, and never from the terminal result.
//
// THE PREDICATE IS A CONJUNCTION — the resolved name is outside the allowlist AND
// the result is error-free. Never the error field alone: a successful allowlisted
// `Read` is also error-free, so an error-keyed guard would flag every clean run.
// The error-free half relies on parseWire() having already collapsed an ABSENT
// `is_error` to `false` — a genuine success omits the field entirely rather than
// setting it false, so absent-vs-false is a real distinction on the wire and this
// guard only reads one value because the parser normalised it. A future reader
// who changes that normalisation must change this predicate with it.
//
// A DANGLING `tool_use` — one with no matching `tool_result` — never enters
// toolResults[] and therefore cannot trip the guard. There is no positive
// evidence that it executed, and this guard is deliberately false-positive-averse
// (a false positive must not discredit an otherwise legitimate answer).
//
// MCP AND SUBAGENT NAMES are moot by construction, not unhandled:
// --strict-mcp-config with an empty mcpServers map means no `mcp__*` name can
// reach the fork at all, and Task/Agent/Workflow are denied, so no nested tool
// use is reachable to carry a name in from a child.
const boundaryViolations = (w: ReturnType<typeof parseWire>) =>
  w.toolResults.filter((r) => r.name !== "" && !r.is_error && !ALLOWED_TOOLS.has(r.name));

// The third state: a `tool_result` whose name did not resolve through the join,
// reachable only when an unparsed wire line ate the originating `tool_use`. It is
// reported on its own line and is deliberately neither a violation nor silence —
// and it must NOT move the exit code. An unverifiable boundary is not a detected
// breach, and counting it as one would false-positive on exactly the truncated
// stream this guard has to survive; ignoring it would re-create the false clean
// sheet the guard exists to close.
const boundaryUnverified = (w: ReturnType<typeof parseWire>) =>
  w.toolResults.filter((r) => r.name === "" && !r.is_error);

// The one degrade exit, so every failure path emits the same guidance and the
// same retry hint. It no longer renders usage itself and takes no wire argument:
// finish() is the single emission point for both the usage line and the boundary
// verdict, and the module-level `wire` it reads is assigned at exactly the point
// the old parameter began being passed. Restoring the parameter would restore
// per-call-site ordering discipline, which is the defect class this shape closes.
const degrade = (why: string): never => {
  if (model === "fable") console.error("fable consult failed — retry with: --model opus");
  console.error(
    `${why}\nDegrade path: answer from the documents + a fresh dispatch (planner-callback policy).`
  );
  finish(3);
};

// stdin from /dev/null so the fork never blocks waiting for piped input; stdout
// captured because it is the event wire, parsed above — the answer is extracted
// from the terminal result event and re-emitted alone, so callers still see
// nothing but answer text on stdout.
// The 64 MB cap was re-examined for the wire and left as it is: stream-json's
// overhead is additive per-event framing, not a multiplier on answer length. It
// stays a deliberate ceiling — exceeding it errors rather than truncating.
// ENOBUFS arrives in two forms and both are guarded: spawnSync may THROW, and it
// may return with `error` set instead. Either way this fails loudly and takes the
// degrade path (exit 3) — a buffer overflow is not a usage error.
type SpawnResult = { status: number | null; stdout: string; error?: Error };
let run: SpawnResult | null = null;
let spawnThrew: Error | null = null;
try {
  run = spawnSync(cmd[0], cmd.slice(1), {
    cwd: repoRoot,
    stdio: ["ignore", "pipe", "inherit"],
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
  });
} catch (err) {
  spawnThrew = err as Error;
}
const spawnFailure = spawnThrew ?? run?.error ?? null;
if (spawnFailure || !run) {
  // The errno (ENOBUFS, ENOENT) is what makes this diagnosable, and it rides on
  // the error object rather than always appearing in its message.
  const errno = (spawnFailure as NodeJS.ErrnoException | null)?.code;
  degrade(
    `consult could not run the fork for ${uuid}: ` +
      `${errno ? `${errno} — ` : ""}${spawnFailure?.message ?? "spawn produced no result"}`
  );
}

// Parsed into a local AND published to the module-level `wire` in one step: the
// local is what the tail below narrows against (TypeScript's narrowing of
// `wire.result` to non-null after a `never`-returning degrade does not survive on
// a module-scope `let`), while the module binding is what finish() reads. The
// publication happens HERE, before any exit below it, which is what makes the
// boundary verdict reach every remaining exit path — including a stream that dies
// with no terminal result.
const w = parseWire(run.stdout ?? "");
wire = w;
if (w.unparsedLines > 0)
  console.error(`warning: ${w.unparsedLines} unparseable line(s) on the event wire — ignored.`);

// Failure detection, rekeyed onto the wire. The old discriminant — empty stdout —
// is obsolete: under stream-json the child emits events whether or not the resume
// worked. The error shape is observed, not assumed: a probe with a nonexistent
// session id against the pinned CLI exited 1 having emitted exactly one stdout
// line, a terminal result of the shape
//     {"type":"result","subtype":"error_during_execution","is_error":true, … ,
//      "errors":["No conversation found with session ID: <uuid>"]}
// with the untouched fields elided here (the full transcript lives in the phase's
// work document). So the discriminant is `is_error`/`subtype`; `errors[]` is
// echoed as message text only, never read for control flow — it is echoed at all
// so the reason survives a caller redirecting the child's inherited stderr away.
if (w.result === null)
  degrade(`consult saw no terminal result event for ${uuid} — the fork did not complete.`);
if (w.result.is_error === true || w.result.subtype !== "success") {
  const errs = Array.isArray(w.result.errors) ? w.result.errors.map(String).join("; ") : "";
  degrade(
    `consult failed on the wire for ${uuid} (subtype: ${w.result.subtype ?? "?"})` +
      (errs ? `: ${errs}` : "")
  );
}
const answer = typeof w.answer === "string" ? w.answer : "";
if (answer.trim() === "")
  degrade(`consult produced no answer for ${uuid} (the fork completed but said nothing).`);

const bytes = Buffer.byteLength(answer, "utf8");
if (bytes > ANSWER_MAX_BYTES) {
  const spillPath = join(tmpdir(), `consult-${uuid}-${Date.now()}.txt`);
  writeFileSync(spillPath, answer);
  console.error(
    `consult: answer is ${bytes} bytes, over the ${ANSWER_MAX_BYTES}-byte threshold — FALLBACK:\n` +
      `the answer was written to ${spillPath} and its path returned on stdout in place of the text.`
  );
  process.stdout.write(`${spillPath}\n`);
} else {
  process.stdout.write(answer.endsWith("\n") ? answer : `${answer}\n`);
}
answerEmitted = true;

// Diagnostic for the correlation above: prints each tool result resolved back to
// the name of the tool that produced it.
if (process.env.CONSULT_DEBUG_TOOLS) {
  for (const r of w.toolResults)
    console.error(
      `tool_result ${r.tool_use_id} → ${r.name || "(unresolved)"}${r.is_error ? " [is_error]" : ""}`
    );
  console.error(`tool_use ids seen: ${w.toolNames.size}`);
}

// The wire said the consult succeeded but the CLI disagreed — reported, never
// papered over, and the caller still takes the degrade path.
let code = 0;
if (run.status !== 0) {
  console.error(`warning: the wire reported success but the child exited ${run.status ?? "null"}.`);
  code = 3;
}

// The usage render is NOT called here — finish() owns it, and calling it here as
// well would double-emit every usage line (the exact cost-reporting defect the
// hoist into degrade() was introduced to fix, re-created from the other side).
// finish() also promotes this code to 5 if the boundary was breached: an answer
// has already reached stdout above, so a breach outranks the incidental
// wire/CLI-disagreement 3, which still reports in prose.
finish(code);
